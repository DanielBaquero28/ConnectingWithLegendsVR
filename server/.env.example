# History Speaks VR proxy — environment variables (spec 4.1, spec 12).
# Copy to .env for local runs (node --env-file=.env src/index.js).
# NEVER commit a real .env; all production values live in Cloud Run env vars.

# Anthropic API key — the LLM (Claude Haiku 5.5 by default, per-character
# modelName/effort in the seed files). Called directly at api.anthropic.com;
# there is no Vertex/Gemini path any more.
ANTHROPIC_API_KEY=

# Data residency for Claude inference: "us" (default; billed at 1.1x) or "global".
CLAUDE_INFERENCE_GEO=us

# Deepgram key — speech-to-text (Nova-3 pre-recorded).
DEEPGRAM_API_KEY=

# Google Cloud Text-to-Speech key — character voice.
GOOGLE_TTS_API_KEY=

# Generative (Chirp) TTS voices are disabled unless this is exactly "true":
# seeding, rendering and live synthesis of any *Chirp* voice fail otherwise.
# ALLOW_GENERATIVE_TTS=false

# Slack incoming webhook URLs (two channels: #hsvr-safety and #hsvr-ops).
SLACK_WEBHOOK_SAFETY=
SLACK_WEBHOOK_OPS=

# Long random string protecting /admin/* endpoints (sent as X-Admin-Key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# Cloud Run injects PORT automatically; only set it for local runs.
PORT=8080

# Firestore uses Application Default Credentials:
# - On Cloud Run: automatic (service account).
# - Locally: run `gcloud auth application-default login` first.
