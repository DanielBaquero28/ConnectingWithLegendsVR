# History Speaks VR proxy — environment variables (spec 4.1).
# Copy to .env for local runs (node --env-file=.env src/index.js).
# NEVER commit a real .env; all production values live in Cloud Run env vars.

# Gemini LLM uses Vertex AI (spec 4) — authenticated by the Cloud Run service
# account via Application Default Credentials, so there is NO Gemini API key.
# Cloud Run sets GOOGLE_CLOUD_PROJECT automatically; only set it for local runs
# (or set VERTEX_PROJECT_ID to override which project the Vertex call bills to).
# GOOGLE_CLOUD_PROJECT=

# Deepgram key — speech-to-text (Nova-3 pre-recorded).
DEEPGRAM_API_KEY=

# Google Cloud Text-to-Speech key — character voice.
GOOGLE_TTS_API_KEY=

# Slack incoming webhook URLs (two channels: #hsvr-safety and #hsvr-ops).
SLACK_WEBHOOK_SAFETY=
SLACK_WEBHOOK_OPS=

# Long random string protecting /admin/* endpoints (sent as X-Admin-Key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# Cloud Run injects PORT automatically; only set it for local runs.
PORT=8080

# Firestore uses Application Default Credentials:
# - On Cloud Run: automatic (service account).
# - Locally: run `gcloud auth application-default login` first.
